# ---------------------------------------------------------------------------
# Discord
# ---------------------------------------------------------------------------
# Bot token from https://discord.com/developers/applications
DISCORD_TOKEN=
# Guild used for fast slash-command registration during development.
DISCORD_GUILD_ID=
# Channel where scouting alerts are posted.
ALERT_CHANNEL_ID=
# Role mentioned on HOT / EXTREME alerts (optional).
ALERT_ROLE_ID=
# Additional user IDs mentioned on EXTREME alerts (comma separated, optional).
ALERT_MENTION_USER_IDS=
# Comma separated Discord role IDs allowed to run admin commands.
ADMIN_ROLE_IDS=
# When true, slash commands are registered globally (use sparingly).
DISCORD_COMMAND_GLOBAL=false

# ---------------------------------------------------------------------------
# Database (MySQL 8.x via the async asyncmy driver)
# ---------------------------------------------------------------------------
DATABASE_URL=mysql+asyncmy://scoutforge:scoutforge@localhost:3306/scoutforge?charset=utf8mb4
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_ECHO=false
# READ COMMITTED keeps a long discovery scan from blocking dashboard reads.
DB_ISOLATION_LEVEL=READ COMMITTED

# ---------------------------------------------------------------------------
# Hard scouting filters
# ---------------------------------------------------------------------------
MIN_CCU=1000
# Optional hard ceiling on lifetime visits. 0 disables it: an established game
# with millions of visits is NOT rejected by default, because the Scout Score
# already weighs audience size and partners buy proven games too.
MAX_LIFETIME_VISITS=0
# Treat games as abandoned when CCU drops below this value AND the game is older
# than ABANDONED_AFTER_DAYS with declining trend. 0 disables abandoned detection.
ABANDONED_CCU_THRESHOLD=50
ABANDONED_AFTER_DAYS=30

# ---------------------------------------------------------------------------
# Worker / scheduling
# ---------------------------------------------------------------------------
SCAN_INTERVAL_SECONDS=600
WORKER_ENABLED=true
SCAN_CONCURRENCY=4
MAX_GAMES_PER_SCAN=400
MAX_DETAIL_FETCHES_PER_SCAN=120
SNAPSHOT_RETENTION_DAYS=180

# ---------------------------------------------------------------------------
# Alert engine
# ---------------------------------------------------------------------------
ALERTS_ENABLED=true
WARM_SCORE=75
HOT_SCORE=90
EXTREME_SCORE=95
# A score increase of this many points re-alerts even inside the cooldown window.
ALERT_SCORE_JUMP_THRESHOLD=5
# A CCU spike of this many percent re-alerts even inside the cooldown window.
ALERT_CCU_SPIKE_PCT=50.0
HOT_ALERT_COOLDOWN_SECONDS=21600
EXTREME_ALERT_COOLDOWN_SECONDS=10800
WARM_ALERT_COOLDOWN_SECONDS=86400
# Only create a lead for games at or above this score.
LEAD_MIN_SCORE=0

# ---------------------------------------------------------------------------
# Scoring weights (must sum to 100 for a 0-100 score)
# ---------------------------------------------------------------------------
SCORE_WEIGHT_RATIO=22
SCORE_WEIGHT_CCU=16
SCORE_WEIGHT_GROWTH=16
SCORE_WEIGHT_CONSISTENCY=10
SCORE_WEIGHT_ENGAGEMENT=8
SCORE_WEIGHT_MONETIZATION=8
SCORE_WEIGHT_FRESHNESS=8
SCORE_WEIGHT_FOOTPRINT=6
SCORE_WEIGHT_ORIGINALITY=6
# Reference values used to normalise each component.
SCORE_CCU_REFERENCE=10000
SCORE_RATIO_REFERENCE=0.02
SCORE_GROWTH_REFERENCE=1.0
SCORE_FRESHNESS_DAYS=30
SCORE_CONSISTENCY_WINDOW_HOURS=24
# Likes+favourites treated as full marks for the monetisation signal.
SCORE_MONETIZATION_VISITS_REFERENCE=500000

# ---------------------------------------------------------------------------
# Partner matching
# ---------------------------------------------------------------------------
PARTNER_MATCHING_ENABLED=true
# Compatible partners below this score are not reported as a fit.
PARTNER_MIN_SCORE=35
PARTNER_MAX_MATCHES_PER_GAME=6
# Only run the matcher against games scoring at least this much.
PARTNER_MIN_GAME_SCORE=0
# Path to a JSON file that replaces the built-in partner profiles.
PARTNER_PROFILES_FILE=
# Overrides the built-in content-risk keyword list (comma separated).
PARTNER_RISK_KEYWORDS=

# ---------------------------------------------------------------------------
# Discovery sources (comma separated, order matters for round-robin)
# Valid names: roblox_explore, roblox_search, roblox_similar
# `scoutforge --check` reports unknown names, so a typo here cannot start a
# worker that silently discovers nothing.
# ---------------------------------------------------------------------------
ENABLED_SOURCES=roblox_explore,roblox_search
# Roblox public API base URLs (override only for testing / mirrors).
ROBLOX_API_BASE=https://apis.roblox.com
ROBLOX_SEARCH_BASE=https://apis.roblox.com
# Be polite. Requests per second per host.
ROBLOX_RATE_LIMIT_RPS=8
ROBLOX_TIMEOUT_SECONDS=15
ROBLOX_MAX_RETRIES=3
ROBLOX_BACKOFF_BASE_SECONDS=0.75
# Number of explore pages fetched per scan per source.
ROBLOX_EXPLORE_PAGES=3
ROBLOX_EXPLORE_SORT=DescPlayers
ROBLOX_SEARCH_TERMS=trending,new,popular,viral,roleplay,simulator
# Optional cache-busting keyword rotation for search based discovery.
ROBLOX_SEARCH_MIN_UNIVERSE_ID=

# ---------------------------------------------------------------------------
# Observability / misc
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=true
TIMEZONE=UTC
ENVIRONMENT=production